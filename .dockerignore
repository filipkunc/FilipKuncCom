.git
.gitignore
node_modules
dist
server-dist
.astro
npm-debug.log*
.env
.env.local
ansible
deploy.sh
rollback.sh
scripts/*
!scripts/gen-og.mjs
!scripts/compress-dist.mjs
# the native-node-addons post reads its excerpts from this workspace at build time
!scripts/addon-example
!scripts/addon-example/**
# the text-rendering post imports the hb-gpu wasm, demo modules, and font
# subsets from this workspace at build time
!scripts/hb-editor
!scripts/hb-editor/**
# the rts-flow-fields post imports the flowfield wasm and demo modules from
# this workspace at build time (target/ is the local cargo build dir)
!scripts/flowfield
!scripts/flowfield/**
scripts/flowfield/target
# the patching-esm post imports the oxc wasm and excerpts the Rust source from
# this workspace at build time (target/ is the local cargo build dir)
!scripts/ast-explorer
!scripts/ast-explorer/**
scripts/ast-explorer/target
# the datastar-shared-board post excerpts the axum server (src/) and both
# clients (ws.html/sse.html) from here at build time. target/ is local-only.
!scripts/collab-board
!scripts/collab-board/**
scripts/collab-board/target
# the meshmaker post excerpts C++/TS snippets mirrored from the MeshMaker repo
!scripts/meshmaker
!scripts/meshmaker/**
# the llm-serving-observability post reads compose.yaml, serve.sh,
# prometheus.yml and agent.py excerpts from this workspace at build time
# (.venv and capture output are local-only)
!scripts/vllm-observability
!scripts/vllm-observability/**
scripts/vllm-observability/.venv
README.md
*.md
.dockerignore
Dockerfile
