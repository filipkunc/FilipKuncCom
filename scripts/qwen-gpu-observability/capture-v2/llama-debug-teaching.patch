+static void print_top_logits(llama_context * ctx, int32_t output_index, size_t n_top) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const float * logits = llama_get_logits_ith(ctx, output_index);
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+
+    std::vector<llama_token> ids(n_vocab);
+    std::iota(ids.begin(), ids.end(), 0);
+    std::partial_sort(ids.begin(), ids.begin() + std::min(n_top, ids.size()), ids.end(),
+        [logits](llama_token a, llama_token b) { return logits[a] > logits[b]; });
+
+    LOG("Top logits (%zu):\n", n_top);
+    for (size_t rank = 0; rank < std::min(n_top, ids.size()); ++rank) {
+        const llama_token id = ids[rank];
+        std::string piece(128, '\0');
+        int n = llama_token_to_piece(vocab, id, piece.data(), piece.size(), 0, true);
+        if (n < 0) {
+            piece = "<conversion failed>";
+        } else {
+            piece.resize(n);
+        }
+        LOG("%2zu  id=%6d  logit=%12.6f  piece=%s\n", rank + 1, id, logits[id], piece.c_str());
+    }
+}
