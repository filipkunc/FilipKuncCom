  .qfr-layers span.attention { border-bottom: 3px solid var(--attn); }
  .qfr-layers span.active { background: color-mix(in srgb, var(--accent) 24%, var(--bg)); outline: 1px solid var(--accent); outline-offset: -1px; color: var(--fg); }
  .qfr-reconstruction { margin-top: 0.3rem; text-align: left; }
  .qfr-kernel-bar { display: flex; height: 13px; overflow: hidden; background: var(--rule); }
  .qfr-kernel-bar span { height: 100%; transition: width 160ms ease; }
  .qfr-kernel-legend { display: flex; flex-wrap: wrap; gap: 0.15rem 0.85rem; margin-top: 0.35rem; color: var(--muted); font-size: 0.68rem; text-align: left; }
