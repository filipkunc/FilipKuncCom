  .qfr-edge { min-height: 1.55rem; padding: 0.22rem 0 0.22rem 12.25rem; border-left: 1px dashed var(--rule); color: var(--muted); font-size: 0.66rem; }
  .qfr-edge span { margin-right: 0.35rem; color: var(--fg); }
  .qfr-token-pieces { display: flex; flex-wrap: wrap; gap: 0.22rem; margin-top: 0.45rem; }
