</style>

<script>
  type ModelPhase = {
    id: string; kind: 'model'; label: string; start: number; end: number; promptSeconds: number;
    promptTokens: number; cachedTokens: number; outputTokens: number; finalContext: number;
    kernelCount: number; setRowsKernels: number; recurrentKernels: number; detail: string;
    kernelMs: Record<string, number>;
  };
  type ToolPhase = { id: string; kind: 'tool'; label: string; start: number; end: number; finalContext: number; detail: string; runtime?: string; toolCode?: string; toolOutput?: string; missingEvidence?: string };
  type Capture = { duration: number; contextLimit: number; architecture: { hiddenSize: number; vocabSize: number; kvBytesPerToken: number }; phases: (ModelPhase | ToolPhase)[]; telemetry: number[][] };

  function setupQwenFlight(fig: HTMLElement) {
    const data = JSON.parse(fig.querySelector('.qfr-data')!.textContent!) as Capture;
    const svg = fig.querySelector<SVGSVGElement>('svg')!;
    const hit = fig.querySelector<SVGRectElement>('.qfr-hit')!;
    const cursor = fig.querySelector<SVGLineElement>('.qfr-cursor')!;
    const utilDot = fig.querySelector<SVGCircleElement>('.qfr-dot.util')!;
    const powerDot = fig.querySelector<SVGCircleElement>('.qfr-dot.power')!;
    const play = fig.querySelector<HTMLButtonElement>('.qfr-play')!;
    const layerEls = [...fig.querySelectorAll<HTMLElement>('[data-layer]')];
    const phaseEls = [...fig.querySelectorAll<SVGGElement>('[data-phase]')];
    const traceEls = [...fig.querySelectorAll<HTMLButtonElement>('[data-trace-phase]')];
    const flowEls = [...fig.querySelectorAll<HTMLElement>('[data-flow-stage]')];
    const passEl = fig.querySelector<HTMLElement>('.qfr-pass')!;
    const blockStateEl = fig.querySelector<HTMLElement>('.qfr-block-state')!;
    const timeEl = fig.querySelector<HTMLElement>('.qfr-time')!;
    const phaseEl = fig.querySelector<HTMLElement>('.qfr-current-phase')!;
    const gpuEl = fig.querySelector<HTMLElement>('.qfr-gpu')!;
    const powerEl = fig.querySelector<HTMLElement>('.qfr-power')!;
    const vramEl = fig.querySelector<HTMLElement>('.qfr-vram')!;
    const positionEl = fig.querySelector<HTMLElement>('.qfr-position')!;
    const spanPanels = [...fig.querySelectorAll<HTMLElement>('[data-span-panel]')];
    const tabEls = [...fig.querySelectorAll<HTMLButtonElement>('[data-qfr-tab]')];
    const tabPanels = [...fig.querySelectorAll<HTMLElement>('[data-qfr-panel]')];
    const kernelCountEl = fig.querySelector<HTMLElement>('.qfr-kernel-count')!;
    const recurrentEl = fig.querySelector<HTMLElement>('.qfr-recurrent-count')!;
    const kvEl = fig.querySelector<HTMLElement>('.qfr-kv-count')!;
    const cacheEl = fig.querySelector<HTMLElement>('.qfr-cache')!;
    const segments = [...fig.querySelectorAll<HTMLElement>('[data-kernel-segment]')];
    const labels = [...fig.querySelectorAll<HTMLElement>('[data-kernel-label]')];
    const LEFT = 48, PW = 624, UTIL_Y = 72, PANEL_H = 58, POWER_Y = 164;
    let current = 0, raf = 0;

    const x = (t: number) => LEFT + (t / data.duration) * PW;
    const utilY = (v: number) => UTIL_Y + PANEL_H - (v / 100) * PANEL_H;
    const powerY = (v: number) => POWER_Y + PANEL_H - (v / 320) * PANEL_H;
    const phaseAt = (t: number) => data.phases.find((p) => t >= p.start && t <= p.end) ?? data.phases.at(-1)!;
    const lastModelAt = (t: number) => [...data.phases].reverse().find((p): p is ModelPhase => p.kind === 'model' && p.start <= t)
      ?? data.phases.find((p): p is ModelPhase => p.kind === 'model')!;
    const sampleAt = (t: number) => {
      const pts = data.telemetry;
      if (t <= pts[0][0]) return pts[0];
      if (t >= pts.at(-1)![0]) return pts.at(-1)!;
      let i = 1; while (i < pts.length && pts[i][0] < t) i++;
      const a = pts[i - 1], b = pts[i], f = (t - a[0]) / (b[0] - a[0]);
      return [t, ...a.slice(1).map((v, j) => v + (b[j + 1] - v) * f)];
    };
    const grouped = (p: ModelPhase) => ({
      weights: p.kernelMs['matrix multiply'],
      quantization: p.kernelMs['quantize / dequantize'],
      attention: p.kernelMs['Flash Attention'] + p.kernelMs['set_rows'] + p.kernelMs['rotary embedding'],
      recurrence: p.kernelMs['Gated DeltaNet'] + p.kernelMs['SSM convolution'],
      glue: p.kernelMs['other'] + p.kernelMs['normalization'] + p.kernelMs['activations'],
    });
    function stop() {
      cancelAnimationFrame(raf); raf = 0; play.setAttribute('aria-pressed', 'false'); play.textContent = '▶ replay';
    }
    function activateTab(name: string, focus = false) {
      tabEls.forEach((tab) => {
        const active = tab.dataset.qfrTab === name;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      tabPanels.forEach((panel) => {
        const active = panel.dataset.qfrPanel === name;
        panel.hidden = !active;
        panel.classList.toggle('active', active);
      });
    }
    function show(t: number) {
      current = Math.max(0, Math.min(data.duration, t));
      const phase = phaseAt(current), model = phase.kind === 'model' ? phase : lastModelAt(current), sample = sampleAt(current);
      const cx = x(current);
      cursor.setAttribute('x1', String(cx)); cursor.setAttribute('x2', String(cx));
      utilDot.setAttribute('cx', String(cx)); utilDot.setAttribute('cy', String(utilY(sample[1])));
      powerDot.setAttribute('cx', String(cx)); powerDot.setAttribute('cy', String(powerY(sample[4])));
      timeEl.textContent = `${current.toFixed(1)}s`; phaseEl.textContent = phase.label;
      gpuEl.textContent = `${Math.round(sample[1])}%`; powerEl.textContent = `${Math.round(sample[4])}W`;
      vramEl.textContent = `${Math.round(sample[3]).toLocaleString()} MiB`;
      phaseEls.forEach((el) => el.classList.toggle('selected', el.dataset.phase === phase.id));
      traceEls.forEach((el) => el.classList.toggle('selected', el.dataset.tracePhase === phase.id));
      spanPanels.forEach((panel) => {
        const active = panel.dataset.spanPanel === phase.id;
        panel.classList.toggle('active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });

      let layer = -1, context = phase.finalContext, position = 'model paused', activeStage = '';
      let passLabel = `${phase.label} · model paused`;
      if (phase.kind === 'model') {
        const local = current - phase.start;
        let cycle = 0;
        if (local < phase.promptSeconds) {
          const f = Math.max(0, local / phase.promptSeconds);
          cycle = f;
          context = Math.round(phase.cachedTokens + (phase.promptTokens - phase.cachedTokens) * f);
          passLabel = `prefill · ${phase.promptTokens - phase.cachedTokens} new + ${phase.cachedTokens} cached tokens`;
        } else {
          const decode = phase.end - phase.start - phase.promptSeconds;
          const f = Math.min(1, (local - phase.promptSeconds) / decode);
          const tokenFloat = Math.min(phase.outputTokens - 0.000001, f * phase.outputTokens);
          const token = Math.floor(tokenFloat) + 1;
          cycle = tokenFloat % 1;
          context = Math.min(phase.finalContext, phase.promptTokens + token - 1);
          passLabel = `decode · token ${token}/${phase.outputTokens}`;
        }

        if (cycle < 0.06) {
          activeStage = 'input'; position = 'tokenize text';
        } else if (cycle < 0.12) {
          activeStage = 'embed'; position = `make ${data.architecture.hiddenSize.toLocaleString()} numbers`;
        } else if (cycle < 0.88) {
          activeStage = 'blocks';
          layer = Math.min(63, Math.floor(((cycle - 0.12) / 0.76) * 64));
          const layerKind = (layer + 1) % 4 === 0 ? 'look back' : 'memory';
          position = `block ${layer}/63 · ${layerKind}`;
        } else if (cycle < 0.92) {
          activeStage = 'norm'; position = 'stabilize numbers';
        } else if (cycle < 0.98) {
          activeStage = 'logits'; position = 'score vocabulary';
        } else {
          activeStage = 'sample'; position = 'sample next token';
        }
      }
      positionEl.textContent = position;
      passEl.textContent = passLabel;
      blockStateEl.textContent = layer >= 0
        ? `block ${layer} · ${(layer + 1) % 4 === 0 ? 'look back at earlier tokens' : 'update running memory'}`
        : '64 blocks: running memory + look-back attention';
      flowEls.forEach((el) => {
        const active = el.dataset.flowStage === activeStage;
        el.classList.toggle('active', active);
        el.classList.toggle('attention', active && layer >= 0 && (layer + 1) % 4 === 0);
        el.classList.toggle('recurrent', active && layer >= 0 && (layer + 1) % 4 !== 0);
      });
      layerEls.forEach((el, i) => el.classList.toggle('active', i === layer));
      cacheEl.textContent = `${(context * data.architecture.kvBytesPerToken / 1048576).toFixed(1)} MiB`;

      kernelCountEl.textContent = `${model.kernelCount.toLocaleString()} launches`;
      recurrentEl.textContent = model.recurrentKernels.toLocaleString(); kvEl.textContent = model.setRowsKernels.toLocaleString();
      const values = grouped(model), total = Object.values(values).reduce((a, b) => a + b, 0);
      segments.forEach((el) => { const key = el.dataset.kernelSegment!; el.style.width = `${values[key as keyof typeof values] / total * 100}%`; });
      labels.forEach((el) => { const key = el.dataset.kernelLabel!; const b = el.querySelector('b')!; b.textContent = `${(values[key as keyof typeof values] / total * 100).toFixed(1)}%`; });
    }
    function scrub(ev: PointerEvent) {
      const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
      show(((pt.x - LEFT) / PW) * data.duration);
    }
    hit.addEventListener('pointerdown', (ev) => { stop(); hit.setPointerCapture(ev.pointerId); scrub(ev); });
    hit.addEventListener('pointermove', (ev) => { if (ev.buttons) scrub(ev); });
    phaseEls.forEach((el) => {
      const jump = () => { stop(); const p = data.phases.find((q) => q.id === el.dataset.phase)!; show(p.start + Math.min(0.5, (p.end - p.start) / 2)); };
      el.addEventListener('click', jump);
      el.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); jump(); } });
    });
    traceEls.forEach((el) => {
      el.addEventListener('click', () => {
        stop();
        const p = data.phases.find((q) => q.id === el.dataset.tracePhase)!;
        show(p.start + Math.min(0.5, (p.end - p.start) / 2));
        activateTab('overview');
      });
    });
    tabEls.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab.dataset.qfrTab!));
      tab.addEventListener('keydown', (ev) => {
        if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
        ev.preventDefault();
        const step = ev.key === 'ArrowRight' ? 1 : -1;
        const next = (index + step + tabEls.length) % tabEls.length;
        activateTab(tabEls[next].dataset.qfrTab!, true);
      });
    });
    play.addEventListener('click', () => {
      if (raf) { stop(); return; }
      play.setAttribute('aria-pressed', 'true'); play.textContent = '❚❚ pause';
      const begin = performance.now(), from = current >= data.duration ? 0 : current;
      const frame = (now: number) => {
        const f = (now - begin) / 12000;
        show(from + f * (data.duration - from));
        if (f < 1) raf = requestAnimationFrame(frame); else stop();
      };
      raf = requestAnimationFrame(frame);
    });
    show(0);
  }
  document.querySelectorAll<HTMLElement>('figure.qwen-flight-recorder').forEach(setupQwenFlight);
</script>
