  .qfr-vector { display: grid; grid-template-columns: repeat(20, 1fr); gap: 2px; height: 1.1rem; margin-top: 0.5rem; align-items: end; }
  .qfr-vector i { height: 55%; background: var(--link); opacity: 0.45; }
  .qfr-vector i:nth-child(3n) { height: 100%; opacity: 0.8; }
  .qfr-vector i:nth-child(4n) { height: 30%; opacity: 0.3; }
  .qfr-block-recipe { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.55rem; color: var(--muted); font-size: 0.64rem; }
  .qfr-block-recipe span { padding: 0.25rem 0.36rem; border: 1px solid var(--rule); color: var(--fg); }
  .qfr-block-recipe i { font-style: normal; }
