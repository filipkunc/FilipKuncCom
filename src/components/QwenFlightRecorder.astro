  .qfr-stage-body > p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.72rem; line-height: 1.4; }
  .qfr-stage.active { border-left-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--bg)); }
