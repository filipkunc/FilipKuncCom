    .qfr-trace-row { grid-template-columns: 7.2rem minmax(0, 1fr) 2.8rem; }
    .qfr-trace-axis { margin: 0 2.8rem 0 7.2rem; }
    .qfr-repro { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .qfr-repro > b { grid-column: 1 / -1; }
