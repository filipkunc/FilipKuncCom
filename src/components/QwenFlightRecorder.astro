---
interface ModelPhase {
  id: string;
  kind: 'model';
  label: string;
  start: number;
  end: number;
  promptSeconds: number;
  promptTokens: number;
  cachedTokens: number;
  outputTokens: number;
  finalContext: number;
  decodeTokensPerSecond: number;
  kernelCount: number;
  setRowsKernels: number;
  recurrentKernels: number;
  gpuAverage: number;
  powerAverage: number;
  energyWh: number;
  detail: string;
  kernelMs: Record<string, number>;
}
interface ToolPhase {
  id: string;
  kind: 'tool';
  label: string;
  start: number;
  end: number;
  finalContext: number;
  detail: string;
  runtime?: string;
  toolCode?: string;
  toolOutput?: string;
  missingEvidence?: string;
}
interface Capture {
  duration: number;
  contextLimit: number;
  architecture: { layers: number; recurrentLayers: number; attentionLayers: number; hiddenSize: number; intermediateSize: number; vocabSize: number; kvBytesPerToken: number };
  phases: (ModelPhase | ToolPhase)[];
  telemetry: number[][];
}
interface Props {
  data: Capture;
  captureHref?: string;
  analysisHref?: string;
  manifestHref?: string;
  readmeHref?: string;
}
const { data, captureHref, analysisHref, manifestHref, readmeHref } = Astro.props;

const W = 680, LEFT = 48, RIGHT = 8, PW = W - LEFT - RIGHT;
const PHASE_Y = 19, PHASE_H = 25;
const UTIL_Y = 72, PANEL_H = 58, POWER_Y = 164;
const H = 236;
const x = (t: number) => LEFT + (t / data.duration) * PW;
const utilY = (v: number) => UTIL_Y + PANEL_H - (v / 100) * PANEL_H;
const powerY = (v: number) => POWER_Y + PANEL_H - (v / 320) * PANEL_H;
const points = data.telemetry.filter((d) => d[0] >= 0 && d[0] <= data.duration);
const utilPoints = points.map((d) => `${x(d[0]).toFixed(1)},${utilY(d[1]).toFixed(1)}`).join(' ');
const powerPoints = points.map((d) => `${x(d[0]).toFixed(1)},${powerY(d[4]).toFixed(1)}`).join(' ');
const xTicks = [0, 15, 30, 45, 60, data.duration];
const firstModel = data.phases.find((p): p is ModelPhase => p.kind === 'model')!;
const groups = (p: ModelPhase) => ({
  weights: p.kernelMs['matrix multiply'],
  quantization: p.kernelMs['quantize / dequantize'],
  attention: p.kernelMs['Flash Attention'] + p.kernelMs['set_rows'] + p.kernelMs['rotary embedding'],
  recurrence: p.kernelMs['Gated DeltaNet'] + p.kernelMs['SSM convolution'],
  glue: p.kernelMs['other'] + p.kernelMs['normalization'] + p.kernelMs['activations'],
});
const firstGroups = groups(firstModel);
const firstTotal = Object.values(firstGroups).reduce((a, b) => a + b, 0);
const colors: Record<string, string> = {
  weights: 'var(--accent)', quantization: 'var(--link)', attention: '#8d7bd8', recurrence: '#49a078', glue: 'var(--muted)',
};
---

<figure class="diagram qwen-flight-recorder">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Replay of the measured Qwen conversation. GPU utilization and power rise for three model turns and fall during two Python tool gaps. Drag across the charts to inspect time, token, layer and cache state.">
    <text class="qfr-label" x={LEFT} y="11">one local conversation · 73.1 seconds wall time</text>
    {data.phases.map((p) => (
      <g class={`qfr-phase ${p.kind}`} data-phase={p.id} role="button" tabindex="0" aria-label={`${p.label}, ${(p.end - p.start).toFixed(1)} seconds`}>
        <rect x={x(p.start)} y={PHASE_Y} width={Math.max(2, x(p.end) - x(p.start))} height={PHASE_H} />
        {(x(p.end) - x(p.start)) > 56 && <text x={(x(p.start) + x(p.end)) / 2} y={PHASE_Y + 16} text-anchor="middle">{p.label}</text>}
      </g>
    ))}

    <text class="qfr-panel-title" x={LEFT} y={UTIL_Y - 10}>GPU busy · measured by NVML</text>
    <text class="qfr-limit" x={LEFT - 6} y={UTIL_Y + 4} text-anchor="end">100%</text>
    <text class="qfr-limit" x={LEFT - 6} y={UTIL_Y + PANEL_H} text-anchor="end">0</text>
    <rect class="qfr-frame" x={LEFT} y={UTIL_Y} width={PW} height={PANEL_H} />
    <line class="qfr-grid" x1={LEFT} y1={utilY(50)} x2={W - RIGHT} y2={utilY(50)} />
    <polyline class="qfr-line util" points={utilPoints} />

    <text class="qfr-panel-title" x={LEFT} y={POWER_Y - 10}>GPU power · measured by NVML</text>
    <text class="qfr-limit" x={LEFT - 6} y={POWER_Y + 4} text-anchor="end">320W</text>
    <text class="qfr-limit" x={LEFT - 6} y={POWER_Y + PANEL_H} text-anchor="end">0</text>
    <rect class="qfr-frame" x={LEFT} y={POWER_Y} width={PW} height={PANEL_H} />
    <line class="qfr-grid" x1={LEFT} y1={powerY(160)} x2={W - RIGHT} y2={powerY(160)} />
    <polyline class="qfr-line power" points={powerPoints} />

    {xTicks.map((t) => (
      <>
        <line class="qfr-time-grid" x1={x(t)} y1={UTIL_Y} x2={x(t)} y2={POWER_Y + PANEL_H} />
        <text class="qfr-tick" x={x(t)} y={H - 2} text-anchor={t === 0 ? 'start' : t === data.duration ? 'end' : 'middle'}>{Math.round(t)}s</text>
      </>
    ))}
    <line class="qfr-cursor" x1={x(0)} y1={PHASE_Y - 3} x2={x(0)} y2={POWER_Y + PANEL_H} />
    <circle class="qfr-dot util" cx={x(0)} cy={utilY(points[0][1])} r="4" />
    <circle class="qfr-dot power" cx={x(0)} cy={powerY(points[0][4])} r="4" />
    <rect class="qfr-hit" x={LEFT} y={UTIL_Y} width={PW} height={POWER_Y + PANEL_H - UTIL_Y} />
  </svg>

  <div class="qfr-controls">
    <button type="button" class="qfr-play" aria-pressed="false">▶ replay</button>
    <span class="qfr-hint">click a phase or drag either plot · replay compresses 73s into 12s</span>
  </div>

  <div class="qfr-trace" aria-label="Trace-like view of the captured conversation">
    <div class="qfr-trace-head">
      <b>session trace</b>
      <span>solid timing is captured · hatched work is reconstructed</span>
    </div>
    <div class="qfr-trace-row root">
      <span class="qfr-trace-name"><small>agent</small>conversation</span>
      <span class="qfr-trace-lane"><i class="qfr-trace-bar conversation" style="left:0%;width:100%" /></span>
      <span class="qfr-trace-duration">{data.duration.toFixed(1)}s</span>
    </div>
    {data.phases.map((phase) => {
      const left = phase.start / data.duration * 100;
      const width = (phase.end - phase.start) / data.duration * 100;
      const prefill = phase.kind === 'model' ? phase.promptSeconds / (phase.end - phase.start) * 100 : 0;
      return (
        <button type="button" class={`qfr-trace-row phase ${phase.kind}`} data-trace-phase={phase.id} aria-label={`${phase.label}, ${(phase.end - phase.start).toFixed(1)} seconds`}>
          <span class="qfr-trace-name"><small>{phase.kind === 'model' ? 'llama.cpp' : 'sandbox + operator'}</small>{phase.label}</span>
          <span class="qfr-trace-lane">
            <i class={`qfr-trace-bar ${phase.kind}`} style={`left:${left}%;width:${width}%`}>
              {phase.kind === 'model' && <span class="qfr-trace-prefill" style={`width:${prefill}%`} />}
              {phase.kind === 'model' && <span class="qfr-trace-reconstruction" />}
            </i>
          </span>
          <span class="qfr-trace-duration">{(phase.end - phase.start).toFixed(1)}s</span>
        </button>
      );
    })}
    <div class="qfr-trace-axis" aria-hidden="true">
      {[0, 15, 30, 45, 60, data.duration].map((tick) => <span style={`left:${tick / data.duration * 100}%`}>{Math.round(tick)}s</span>)}
    </div>
    <div class="qfr-trace-key">
      <span><i class="model" /> model request</span>
      <span><i class="prefill" /> prefill inside request</span>
      <span><i class="tool" /> tool + capture gap</span>
      <span><i class="reconstructed" /> 64-block passes, illustrative timing</span>
    </div>
  </div>

  <output class="qfr-readout" aria-live="off">
    <span><b class="qfr-time">0.0s</b></span>
    <span><small>phase</small><b class="qfr-current-phase">{firstModel.label}</b></span>
    <span><small>GPU</small><b class="qfr-gpu">{Math.round(points[0][1])}%</b></span>
    <span><small>power</small><b class="qfr-power">{Math.round(points[0][4])}W</b></span>
    <span><small>VRAM</small><b class="qfr-vram">{Math.round(points[0][3]).toLocaleString()} MiB</b></span>
    <span><small>illustration</small><b class="qfr-position">prefill · layer 0</b></span>
  </output>

  <div class="qfr-tabs" role="tablist" aria-label="Trace details">
    <button type="button" role="tab" aria-selected="true" aria-controls="qfr-overview" data-qfr-tab="overview">overview</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="qfr-execution" data-qfr-tab="execution" tabindex="-1">execution</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="qfr-cuda" data-qfr-tab="cuda" tabindex="-1">CUDA</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="qfr-reproduce" data-qfr-tab="reproduce" tabindex="-1">reproduce</button>
  </div>

  <div class="qfr-tab-panel active" id="qfr-overview" role="tabpanel" data-qfr-panel="overview">
  <div class="qfr-span-panels">
    {data.phases.map((phase, index) => (
      <section class={`qfr-span-panel ${index === 0 ? 'active' : ''}`} data-span-panel={phase.id} aria-hidden={index === 0 ? 'false' : 'true'}>
        <div class="qfr-span-title">
          <b>{phase.label}</b>
          <span>{phase.kind === 'model' ? 'API timings + Nsight/NVML' : 'outer gap measured; inner tool timing not isolated'}</span>
        </div>
        <p>{phase.detail}</p>
        {phase.kind === 'model' ? (
          <dl class="qfr-span-facts">
            <div><dt>prompt eval</dt><dd>{phase.promptSeconds.toFixed(3)}s</dd></div>
            <div><dt>prompt tokens</dt><dd>{phase.promptTokens.toLocaleString()}</dd></div>
            <div><dt>cache reused</dt><dd>{phase.cachedTokens.toLocaleString()}</dd></div>
            <div><dt>output tokens</dt><dd>{phase.outputTokens.toLocaleString()}</dd></div>
            <div><dt>decode rate</dt><dd>{phase.decodeTokensPerSecond.toFixed(2)} tok/s</dd></div>
          </dl>
        ) : (
          <>
            {phase.runtime && <p class="qfr-runtime"><small>runtime</small>{phase.runtime}</p>}
            {phase.toolCode && <details class="qfr-tool-details"><summary>exact generated Python and stdout</summary><pre class="qfr-tool-code"><code>{phase.toolCode}</code></pre>{phase.toolOutput && <p class="qfr-tool-output"><small>stdout</small><code>{phase.toolOutput}</code></p>}</details>}
            {phase.missingEvidence && <p class="qfr-missing"><small>reproducibility limit</small>{phase.missingEvidence}</p>}
          </>
        )}
      </section>
    ))}
  </div>
  </div>

  <div class="qfr-tab-panel" id="qfr-execution" role="tabpanel" data-qfr-panel="execution" hidden>
  <div class="qfr-flow-head">
    <b>how Qwen makes one more token</b>
    <span class="qfr-pass">prefill · prompt batch</span>
  </div>
  <div class="qfr-flow" role="img" aria-label={`Beginner view of one Qwen forward pass. Text is split into token IDs. Every ID selects ${data.architecture.hiddenSize.toLocaleString()} learned numbers. Each of ${data.architecture.layers} blocks updates those numbers using earlier context and a neural network. The final numbers become ${data.architecture.vocabSize.toLocaleString()} scores, and the sampler chooses the next token.`}>
    <div class="qfr-stage" data-flow-stage="input">
      <span class="qfr-step"><small>1</small>text becomes numbered pieces</span>
      <div class="qfr-stage-body">
        <b>“Solve x^x = 10”</b>
        <p>The tokenizer splits all messages and the tool description into small pieces. The six pieces below are simplified; the exact split was not saved.</p>
        <span class="qfr-token-pieces"><i>Solve</i><i>x</i><i>^</i><i>x</i><i>=</i><i>10</i></span>
      </div>
    </div>
    <div class="qfr-edge"><span>↓</span> each token ID looks up one learned row</div>

    <div class="qfr-stage" data-flow-stage="embed">
      <span class="qfr-step"><small>2</small>a token becomes numbers</span>
      <div class="qfr-stage-body">
        <b>one token → {data.architecture.hiddenSize.toLocaleString()} numbers</b>
        <p>These numbers are the model's working representation of that token. They do not have fixed labels such as “math” or “variable”; their meaning comes from how the network uses them together.</p>
        <span class="qfr-vector" aria-hidden="true">{Array.from({ length: 20 }, () => <i />)}</span>
      </div>
    </div>
    <div class="qfr-edge"><span>↓</span> the same-sized representation enters block 0</div>

    <div class="qfr-stage blocks" data-flow-stage="blocks">
      <span class="qfr-step"><small>3</small>64 blocks revise the representation</span>
      <div class="qfr-stage-body">
        <b class="qfr-block-state">block 0 · recurrent memory</b>
        <p>Every block receives {data.architecture.hiddenSize.toLocaleString()} numbers and returns the same amount. It mixes in information from earlier tokens, changes useful features with another learned network, then adds the update to what it received.</p>
        <div class="qfr-block-recipe" aria-label="What one block does">
          <span>{data.architecture.hiddenSize.toLocaleString()} numbers in</span><i>→</i><span>mix with the past</span><i>→</i><span>feature network {data.architecture.hiddenSize.toLocaleString()} → {data.architecture.intermediateSize.toLocaleString()} → {data.architecture.hiddenSize.toLocaleString()}</span><i>→</i><span>add the old values</span><i>→</i><span>{data.architecture.hiddenSize.toLocaleString()} out</span>
        </div>
        <div class="qfr-memory-kinds">
          <span><i class="recurrent"></i><b>48 recurrent blocks</b><small>carry a compressed running memory forward</small></span>
          <span><i class="attention"></i><b>16 attention blocks</b><small>compare the current token with all earlier tokens</small></span>
        </div>
        <div class="qfr-layer-head">
          <b>the same representation visits every block</b>
          <span><i class="recurrent"></i> running memory <i class="attention"></i> look back at tokens</span>
        </div>
        <div class="qfr-layers" aria-label="64 model blocks; every fourth block uses full attention">
          {Array.from({ length: data.architecture.layers }, (_, i) => (
            <span class={(i + 1) % 4 === 0 ? 'attention' : 'recurrent'} data-layer={i}>{i}</span>
          ))}
        </div>
      </div>
    </div>
    <div class="qfr-edge"><span>↓</span> block 63 returns the final {data.architecture.hiddenSize.toLocaleString()} numbers</div>

    <div class="qfr-stage compact" data-flow-stage="norm">
      <span class="qfr-step"><small>4</small>put the numbers on a stable scale</span>
      <div class="qfr-stage-body"><b>output normalization</b><p>This keeps very large or very small values from dominating the last calculation.</p></div>
    </div>
    <div class="qfr-edge"><span>↓</span> compare the final representation with every possible token</div>

    <div class="qfr-stage compact" data-flow-stage="logits">
      <span class="qfr-step"><small>5</small>score every possible next token</span>
      <div class="qfr-stage-body"><b>{data.architecture.hiddenSize.toLocaleString()} numbers → {data.architecture.vocabSize.toLocaleString()} scores</b><p>A larger score means that token is a better continuation according to the model.</p></div>
    </div>
    <div class="qfr-edge"><span>↓</span> turn scores into probabilities and choose</div>

    <div class="qfr-stage compact" data-flow-stage="sample">
      <span class="qfr-step"><small>6</small>choose one token and repeat</span>
      <div class="qfr-stage-body"><b>next token joins the context ↺</b><p>Decode runs this whole path again for every generated token.</p></div>
    </div>
  </div>
  <div class="qfr-reconstruction">The structure and dimensions come from the model configuration. The moving highlight is only a slowed-down teaching aid; Nsight did not record which block was active at each instant.</div>
  </div>

  <div class="qfr-tab-panel" id="qfr-cuda" role="tabpanel" data-qfr-panel="cuda" hidden>
  <div class="qfr-kernel-head">
    <b>CUDA time grouped by kernel-name rules</b>
    <span class="qfr-kernel-count">{firstModel.kernelCount.toLocaleString()} launches</span>
  </div>
  <div class="qfr-kernel-bar">
    {Object.entries(firstGroups).map(([name, value]) => (
      <span data-kernel-segment={name} style={`width:${value / firstTotal * 100}%;background:${colors[name]}`} />
    ))}
  </div>
  <div class="qfr-kernel-legend">
    {Object.entries(firstGroups).map(([name, value]) => (
      <span data-kernel-label={name}><i style={`background:${colors[name]}`} />{name} <b>{(value / firstTotal * 100).toFixed(1)}%</b></span>
    ))}
  </div>
  <div class="qfr-counts">
    <span><small>Gated DeltaNet-name matches</small><b class="qfr-recurrent-count">{firstModel.recurrentKernels.toLocaleString()}</b></span>
    <span><small>set_rows-name matches</small><b class="qfr-kv-count">{firstModel.setRowsKernels.toLocaleString()}</b></span>
    <span><small>calculated K + V size</small><b class="qfr-cache">0 MiB</b></span>
  </div>
  </div>

  <div class="qfr-tab-panel" id="qfr-reproduce" role="tabpanel" data-qfr-panel="reproduce" hidden>
    <div class="qfr-repro">
      <b>reproduction map</b>
      <span><small>1 · setup</small><a href={readmeHref}>exact build, launch flags and prompt</a></span>
      <span><small>2 · evidence</small><a href={captureHref}>committed telemetry and turn aggregates</a></span>
      <span><small>3 · transform</small><a href={analysisHref}>executable kernel classifier</a></span>
      <span><small>4 · raw inputs</small><a href={manifestHref}>not committed; sizes and SHA-256 only</a></span>
    </div>
  </div>

  <figcaption><slot /></figcaption>
  <script type="application/json" class="qfr-data" set:html={JSON.stringify(data)} />
</figure>

<style>
  figure.qwen-flight-recorder { --attn: #8d7bd8; --rec: #49a078; }
  :global(:root[data-theme='light']) figure.qwen-flight-recorder { --attn: #6956b8; --rec: #26774f; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) figure.qwen-flight-recorder { --attn: #6956b8; --rec: #26774f; }
  }
  .qfr-label, .qfr-limit, .qfr-tick { fill: var(--muted); font: 10px ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .qfr-panel-title { fill: var(--fg); font: 600 12px ui-sans-serif, system-ui, sans-serif; }
  .qfr-frame { fill: none; stroke: var(--rule); }
  .qfr-grid, .qfr-time-grid { stroke: var(--rule); stroke-width: 1; opacity: 0.55; stroke-dasharray: 2 4; }
  .qfr-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .qfr-line.util { stroke: var(--link); }
  .qfr-line.power { stroke: var(--accent); }
  .qfr-dot.util { stroke: var(--link); fill: var(--link); }
  .qfr-dot.power { stroke: var(--accent); fill: var(--accent); }
  .qfr-phase { cursor: pointer; outline: none; }
  .qfr-phase rect { stroke: var(--bg); stroke-width: 2; }
  .qfr-phase.model rect { fill: color-mix(in srgb, var(--link) 32%, var(--bg)); }
  .qfr-phase.tool rect { fill: color-mix(in srgb, var(--muted) 22%, var(--bg)); }
  .qfr-phase.selected rect, .qfr-phase:hover rect, .qfr-phase:focus-visible rect { stroke: var(--fg); }
  .qfr-phase text { fill: var(--fg); font: 10px ui-sans-serif, system-ui, sans-serif; pointer-events: none; }
  .qfr-cursor { stroke: var(--fg); stroke-width: 1; opacity: 0.7; pointer-events: none; }
  .qfr-dot { pointer-events: none; }
  .qfr-hit { fill: transparent; cursor: crosshair; touch-action: pan-y; }
  .qfr-controls { display: flex; align-items: center; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.45rem; }
  .qfr-play {
    color: var(--fg); background: transparent; border: 1px solid var(--rule); border-radius: 999px;
    padding: 0.2rem 0.7rem; font: inherit; font-size: 0.8rem; cursor: pointer;
  }
  .qfr-play[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  .qfr-hint, .qfr-reconstruction { color: var(--muted); font-size: 0.75rem; }
  .qfr-trace { margin-top: 0.8rem; padding-top: 0.65rem; border-top: 1px solid var(--rule); }
  .qfr-trace-head, .qfr-flow-head, .qfr-layer-head, .qfr-kernel-head {
    display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin: 0 0 0.35rem; text-align: left;
  }
  .qfr-trace-head > span, .qfr-flow-head > span, .qfr-layer-head > span, .qfr-kernel-head > span { color: var(--muted); font-size: 0.72rem; }
  .qfr-trace-row {
    display: grid; grid-template-columns: 9.8rem minmax(0, 1fr) 3.2rem; width: 100%; min-height: 2rem;
    padding: 0; border: 0; color: inherit; background: transparent; font: inherit; text-align: left;
  }
  button.qfr-trace-row { cursor: pointer; }
  button.qfr-trace-row:hover, button.qfr-trace-row:focus-visible, button.qfr-trace-row.selected {
    background: color-mix(in srgb, var(--accent) 9%, transparent); outline: none;
  }
  .qfr-trace-name { min-width: 0; padding: 0.2rem 0.45rem 0.2rem 0.15rem; font: 600 0.7rem ui-monospace, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qfr-trace-row.phase .qfr-trace-name { padding-left: 0.85rem; }
  .qfr-trace-name small { display: block; color: var(--muted); font: 0.56rem ui-sans-serif, system-ui, sans-serif; text-transform: uppercase; letter-spacing: 0.06em; }
  .qfr-trace-lane { position: relative; min-width: 0; border-left: 1px solid var(--rule); background-image: repeating-linear-gradient(90deg, transparent 0, transparent calc(20% - 1px), color-mix(in srgb, var(--rule) 55%, transparent) calc(20% - 1px), color-mix(in srgb, var(--rule) 55%, transparent) 20%); }
  .qfr-trace-bar { position: absolute; top: 0.42rem; bottom: 0.42rem; min-width: 2px; overflow: visible; background: color-mix(in srgb, var(--link) 45%, var(--bg)); }
  .qfr-trace-bar.conversation { background: color-mix(in srgb, var(--link) 20%, var(--bg)); border: 1px solid color-mix(in srgb, var(--link) 45%, var(--rule)); }
  .qfr-trace-bar.model { background: color-mix(in srgb, var(--link) 50%, var(--bg)); }
  .qfr-trace-bar.tool { background: color-mix(in srgb, var(--muted) 34%, var(--bg)); }
  .qfr-trace-duration { display: grid; align-items: center; padding-right: 0.15rem; color: var(--muted); font: 0.62rem ui-monospace, monospace; text-align: right; font-variant-numeric: tabular-nums; }
  .qfr-trace-row.root .qfr-trace-duration { color: var(--fg); }
  .qfr-trace-prefill { position: absolute; inset: 0 auto 0 0; min-width: 2px; background: color-mix(in srgb, var(--link) 22%, var(--bg)); }
