  .qfr-step small { display: grid; flex: 0 0 1.45rem; width: 1.45rem; height: 1.45rem; place-items: center; border: 1px solid var(--rule); border-radius: 50%; color: var(--fg); font: 600 0.66rem ui-monospace, monospace; }
