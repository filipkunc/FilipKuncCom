---
// Playable: the same motion rendered two ways. The top dot snaps to each 30 Hz
// update and visibly steps; the bottom dot glides between the last two updates,
// a little behind, and stays smooth. Press play and watch the top one stutter.
---

<figure class="diagram interp-demo">
  <svg viewBox="0 0 680 200" role="img"
    aria-label="The same left-right motion shown twice. The top dot jumps to each network update and steps. The bottom dot interpolates between the last two updates and moves smoothly.">
    <!-- update ticks: where the latest network update currently sits -->
    <line class="id-track" x1="100" y1="60" x2="580" y2="60" />
    <line class="id-track" x1="100" y1="140" x2="580" y2="140" />

    <text class="id-lane" x="100" y="42">snap to the latest update (choppy)</text>
    <text class="id-lane" x="100" y="122">interpolate between updates (smooth)</text>

    <!-- where the newest update landed, as a faint marker on both lanes -->
    <line class="id-update" x1="340" y1="50" x2="340" y2="150" />

    <circle class="id-raw" cx="340" cy="60" r="9" />
    <circle class="id-smooth" cx="340" cy="140" r="9" />
  </svg>
  <div class="diag-controls">
    <button type="button" class="diag-play" aria-pressed="false">▶ play</button>
    <span class="diag-hint">watch the top dot jump and the bottom dot glide</span>
  </div>
  <figcaption>
    Both dots follow the same path. The top one snaps to each update as it lands, so it steps. The bottom one
    draws a little behind, on the line between the last two updates, so it stays smooth at any refresh rate.
  </figcaption>
</figure>

<style>
  figure.interp-demo .id-track { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 2 5; }
  figure.interp-demo .id-update { stroke: var(--accent); stroke-width: 1; opacity: 0.35; }
  figure.interp-demo .id-lane { fill: var(--muted); font: 12px ui-sans-serif, system-ui, sans-serif; }
  figure.interp-demo .id-raw { fill: var(--muted); }
  figure.interp-demo .id-smooth { fill: var(--accent); }
  .diag-controls { display: flex; align-items: center; gap: 0.75rem; justify-content: center; margin-top: 0.5rem; }
  .diag-play {
    font: inherit; font-size: 0.8rem; padding: 0.2rem 0.7rem; cursor: pointer;
    color: var(--fg); background: transparent; border: 1px solid var(--rule); border-radius: 999px;
  }
  .diag-play[aria-pressed="true"] { background: color-mix(in srgb, var(--accent) 18%, transparent); border-color: var(--accent); }
  .diag-hint { font-size: 0.78rem; color: var(--muted); }
</style>

<script>
  // Drive both dots from one underlying motion. The raw dot only updates when a
  // new sample "arrives" (every SAMPLE ms), so it steps. The smooth dot draws
  // DELAY ms in the past, interpolated between the two samples bracketing it.
  function setup(fig: HTMLElement) {
    const raw = fig.querySelector<SVGCircleElement>('.id-raw')!;
    const smooth = fig.querySelector<SVGCircleElement>('.id-smooth')!;
    const update = fig.querySelector<SVGLineElement>('.id-update')!;
    const btn = fig.querySelector<HTMLButtonElement>('.diag-play')!;

    const X0 = 130, X1 = 550, MID = (X0 + X1) / 2, AMP = (X1 - X0) / 2;
    const PERIOD = 3600, SAMPLE = 200, DELAY = 320;
    const motion = (t: number) => MID + AMP * Math.sin((2 * Math.PI * t) / PERIOD);

    let samples: { t: number; x: number }[] = [];
    let t = 0, lastSample = -1e9, raf = 0, prev = 0;

    function frame(now: number) {
      const dt = prev ? now - prev : 16;
      prev = now;
      t += dt;

      if (t - lastSample >= SAMPLE) {
        lastSample = t;
        samples.push({ t, x: motion(t) });
        if (samples.length > 12) samples.shift();
      }
      const latest = samples[samples.length - 1];
      if (latest) { raw.setAttribute('cx', String(latest.x)); update.setAttribute('x1', String(latest.x)); update.setAttribute('x2', String(latest.x)); }

      const rt = t - DELAY;
      let s0 = samples[0], s1 = samples[0];
      for (const s of samples) { if (s.t <= rt) s0 = s; else { s1 = s; break; } }
      const f = s1.t > s0.t ? Math.max(0, Math.min(1, (rt - s0.t) / (s1.t - s0.t))) : 0;
      smooth.setAttribute('cx', String(s0.x + (s1.x - s0.x) * f));

      raf = requestAnimationFrame(frame);
    }

    btn.addEventListener('click', () => {
      if (raf) {
        cancelAnimationFrame(raf); raf = 0; prev = 0;
        btn.setAttribute('aria-pressed', 'false'); btn.textContent = '▶ play';
      } else {
        btn.setAttribute('aria-pressed', 'true'); btn.textContent = '❚❚ pause';
        raf = requestAnimationFrame(frame);
      }
    });
  }
  document.querySelectorAll<HTMLElement>('figure.interp-demo').forEach(setup);
</script>
