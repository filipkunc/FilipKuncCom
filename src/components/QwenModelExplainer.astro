<script>
  function setupQwenModelExplainer(figure: HTMLElement) {
    const tabs = [...figure.querySelectorAll<HTMLButtonElement>('[data-qme-tab]')];
    const panels = [...figure.querySelectorAll<HTMLElement>('[data-qme-panel]')];
    const route = [...figure.querySelectorAll<HTMLElement>('[data-route]')];

    function activate(name: string, focus = false) {
      tabs.forEach((tab) => {
        const active = tab.dataset.qmeTab === name;
        tab.setAttribute('aria-selected', String(active));
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.qmePanel !== name; });
      route.forEach((item) => {
        const active = item.dataset.route === name
          || (name === 'memory' || name === 'attention' || name === 'cuda') && item.dataset.route === 'round';
        item.classList.toggle('active', active);
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.qmeTab!));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const next = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[next].dataset.qmeTab!, true);
      });
    });
    const kernelButtons = [...figure.querySelectorAll<HTMLButtonElement>('[data-kernel]')];
    const kernelPanels = [...figure.querySelectorAll<HTMLElement>('[data-kernel-panel]')];
    kernelButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const name = button.dataset.kernel;
        kernelButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        kernelPanels.forEach((panel) => { panel.hidden = panel.dataset.kernelPanel !== name; });
      });
    });
    activate('tokens');
  }
  document.querySelectorAll<HTMLElement>('figure.qwen-model-explainer').forEach(setupQwenModelExplainer);
</script>
