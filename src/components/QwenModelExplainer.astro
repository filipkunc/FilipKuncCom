---
interface Token { id: number; piece: string | number[] }
interface TeachingCapture {
  provenance: { date: string; modelFile: string; llamaCppCommit: string };
  question: string;
  tokenizer: {
    model: string;
    preprocessor: string;
    promptTokenCount: number;
    segments: { id: string; label: string; start: number; end: number }[];
    queryTokens: Token[];
    tokens: Token[];
  };
  architecture: {
    layers: number;
    hiddenSize: number;
    intermediateSize: number;
    queryHeads: number;
    kvHeads: number;
    headSize: number;
    recurrent: { convKernel: number; stateSize: number; valueHeads: number };
    vocabSize: number;
  };
  layers: { index: number; kind: 'recurrent' | 'attention' }[];
  topLogits: { rank: number; id: number; logit: number; piece: string }[];
}
interface Props {
  data: TeachingCapture;
  profile?: {
    phases: {
      kind: string;
      label: string;
      start: number;
      end: number;
      kernelCount?: number;
      kernelMs?: Record<string, number>;
    }[];
  };
  evidenceHref?: string;
}

const { data, profile, evidenceHref } = Astro.props;
const { architecture: a, tokenizer } = data;
const tokenPiece = (value: string | number[]) => typeof value === 'string'
  ? value.replaceAll('\n', '↵').replaceAll(' ', '·') || '∅'
  : value.map((byte) => `0x${byte.toString(16).padStart(2, '0')}`).join(' ');
const segmentTotal = tokenizer.segments.reduce((sum, segment) => sum + segment.end - segment.start, 0);
const maxLogit = data.topLogits[0]?.logit ?? 1;
const projectionProducts = a.hiddenSize * a.intermediateSize;
const llamaSourceBase = `https://github.com/unslothai/llama.cpp/blob/${data.provenance.llamaCppCommit}`;
const profiledTurn = profile?.phases.find((phase) => phase.kind === 'model' && phase.kernelMs);
const profileTotalMs = Object.values(profiledTurn?.kernelMs ?? {}).reduce((sum, value) => sum + value, 0);
const kernelExplanations = [
  {
    group: 'matrix multiply',
    label: 'multiply + add',
    kernel: 'mul_mat* / gemm*',
    note: 'The same dot product from tab 2, tiled across many rows and tokens.',
    source: 'same math, simplified',
    code: `float out = 0;\nfor (int i = 0; i < 5120; ++i)\n    out += x[i] * weight[row][i];`,
  },
  {
    group: 'quantize / dequantize',
    label: 'unpack weights',
    kernel: 'quantize* / dequantize*',
    note: 'This model stores weights in compressed blocks. The kernel recovers usable values while multiplying.',
    source: 'same math, simplified',
    code: `float w = scale[block] * unpack(packed_weights, i);\nsum += x[i] * w;`,
  },
  {
    group: 'normalization',
    label: 'keep scale steady',
    kernel: '*norm*',
    note: 'Find the typical size of the row, divide by it, then apply one learned scale per position.',
    source: 'same math, simplified',
    code: `rms = sqrt(sum(x[i] * x[i]) / 5120 + eps);\nout[i] = x[i] / rms * learned_scale[i];`,
  },
  {
    group: 'activations',
    label: 'bend + gate',
    kernel: 'silu* / sigmoid* / softplus*',
    note: 'SiLU bends one learned result; pairwise multiplication uses it as a gate for another.',
    source: 'same math, simplified',
    code: `silu = x / (1.0f + expf(-x));\nout = silu * other_learned_result;`,
  },
  {
    group: 'Flash Attention',
    label: 'look back',
    kernel: 'flash_attn*',
    note: 'Score old positions, turn the scores into weights, then copy a weighted mixture of their values.',
    source: 'same math, simplified',
    code: `score = dot(q, k) / 16.0f;\nweight = softmax(score);\nout += weight * v;`,
  },
  {
    group: 'Gated DeltaNet',
    label: 'update memory',
    kernel: 'gated_delta_net*',
    note: 'This excerpt is from the CUDA kernel used by the captured llama.cpp commit.',
    source: 'ggml-cuda/gated_delta_net.cu',
    sourcePath: 'ggml/src/ggml-cuda/gated_delta_net.cu#L82-L116',
    code: `float delta_col = (v_t[col] - g_val * kv_col) * beta_val;\ns_shard[r] = g_val * s_shard[r] + k_reg[r] * delta_col;\nattn_partial += s_shard[r] * q_reg[r];`,
  },
  {
    group: 'SSM convolution',
    label: 'mix four positions',
    kernel: 'ssm_conv*',
    note: 'Before the memory update, each channel combines the current input with the previous three.',
    source: 'same math, simplified',
    code: `out[t] = w[0] * x[t]\n       + w[1] * x[t - 1]\n       + w[2] * x[t - 2]\n       + w[3] * x[t - 3];`,
  },
].map((item) => {
  const milliseconds = profiledTurn?.kernelMs?.[item.group] ?? 0;
  return { ...item, milliseconds, percent: profileTotalMs ? milliseconds / profileTotalMs * 100 : 0 };
});
---

<figure class="diagram qwen-model-explainer">
  <div class="qme-head">
    <div>
      <b>one Qwen pass, reduced to arithmetic</b>
      <span>{data.provenance.modelFile}</span>
    </div>
    <span>exact route · tiny worked examples</span>
  </div>

  <p class="qme-warning">The small numbers below are made up so the calculation fits on screen. The operations and the large sizes beside them come from the exact llama.cpp source and GGUF used for the rerun.</p>

  <div class="qme-route" aria-label="The path from the question to Qwen's next token">
    <span data-route="tokens"><small>text</small>Solve x<sup>x</sup> = 10</span><i>→</i>
    <span data-route="tokens"><small>numbered pieces</small>{tokenizer.promptTokenCount} IDs</span><i>→</i>
    <span data-route="multiply"><small>table lookup</small>{a.hiddenSize.toLocaleString()} numbers per ID</span><i>→</i>
    <span data-route="round"><small>change the numbers</small>{a.layers} rounds</span><i>→</i>
    <span data-route="choose"><small>score endings</small>{a.vocabSize.toLocaleString()} scores</span><i>→</i>
    <span data-route="choose"><small>next piece</small>“{data.topLogits[0]?.piece}”</span>
  </div>

  <div class="qme-tabs" role="tablist" aria-label="Follow the arithmetic">
    <button id="qme-tab-tokens" type="button" role="tab" aria-selected="true" aria-controls="qme-tokens" data-qme-tab="tokens">1 · text</button>
    <button id="qme-tab-multiply" type="button" role="tab" aria-selected="false" aria-controls="qme-multiply" data-qme-tab="multiply">2 · multiply</button>
    <button id="qme-tab-memory" type="button" role="tab" aria-selected="false" aria-controls="qme-memory" data-qme-tab="memory">3 · remember</button>
    <button id="qme-tab-attention" type="button" role="tab" aria-selected="false" aria-controls="qme-attention" data-qme-tab="attention">4 · look back</button>
    <button id="qme-tab-round" type="button" role="tab" aria-selected="false" aria-controls="qme-round" data-qme-tab="round">5 · one round</button>
    <button id="qme-tab-choose" type="button" role="tab" aria-selected="false" aria-controls="qme-choose" data-qme-tab="choose">6 · choose</button>
    <button id="qme-tab-cuda" type="button" role="tab" aria-selected="false" aria-controls="qme-cuda" data-qme-tab="cuda">7 · CUDA</button>
  </div>

  <section class="qme-panel" id="qme-tokens" role="tabpanel" aria-labelledby="qme-tab-tokens" data-qme-panel="tokens">
    <header><small>what enters the model</small><b>The visible question is 9 pieces, not 6 boxes</b></header>
    <div class="qme-question-tokens" aria-label="Exact tokenization of Solve x to the power x equals 10">
      {tokenizer.queryTokens.map((token) => <span><b>{tokenPiece(token.piece)}</b><small>ID {token.id}</small></span>)}
    </div>
    <p>Qwen never receives words. It receives these integers. ID 830 means <code>·x</code>; the dot shows that the leading space is part of the piece.</p>
    <div class="qme-token-bar" aria-label="The complete prompt split into setup, user turn and assistant opening">
      {tokenizer.segments.map((segment) => (
        <span class={segment.id} style={`width:${(segment.end - segment.start) / segmentTotal * 100}%`} />
      ))}
    </div>
    <div class="qme-token-key">
      {tokenizer.segments.map((segment) => <span><i class={segment.id} />{segment.label}: <b>{segment.end - segment.start}</b></span>)}
    </div>
    <p>Only 14 IDs belong to the user turn. The other 359 describe the tool, the chat format and the start of Qwen's answer.</p>
    <details class="qme-all-tokens">
      <summary>show all {tokenizer.promptTokenCount} IDs</summary>
      <div>{tokenizer.tokens.map((token, index) => <span title={`position ${index}`}><b>{tokenPiece(token.piece)}</b><small>{token.id}</small></span>)}</div>
    </details>
  </section>

  <section class="qme-panel" id="qme-multiply" role="tabpanel" aria-labelledby="qme-tab-multiply" data-qme-panel="multiply" hidden>
    <header><small>the operation that dominates the run</small><b>Multiply matching numbers, then add the results</b></header>
    <div class="qme-dot-product" aria-label="Two times four plus three times minus one equals five">
      <div><small>numbers coming in</small><span>2</span><span>3</span></div>
      <i>×</i>
      <div><small>one learned row</small><span>4</span><span>−1</span></div>
      <i>→</i>
      <div class="qme-products"><small>multiply pairs</small><span>2 × 4</span><span>3 × −1</span></div>
      <i>→</i>
      <div class="answer"><small>add</small><b>8 − 3 = 5</b></div>
    </div>
    <p>This is a <em>dot product</em>. A learned table contains many rows. Every row makes one new number. Put all the rows together and the same work is called a matrix multiplication.</p>
    <div class="qme-real-size">
      <span><small>one real Qwen projection</small><b>{a.hiddenSize.toLocaleString()} numbers in</b></span><i>×</i>
      <span><b>{a.intermediateSize.toLocaleString()} learned rows</b></span><i>＝</i>
      <span><b>{a.intermediateSize.toLocaleString()} numbers out</b></span>
    </div>
    <p>That represents {projectionProducts.toLocaleString()} pairwise multiplications for one token and one such projection. The GPU does many rows and tokens together. The GGUF stores compressed weights, so the CUDA kernel also unpacks them; this diagram shows the mathematical result, not one GPU instruction at a time.</p>
  </section>

  <section class="qme-panel" id="qme-memory" role="tabpanel" aria-labelledby="qme-tab-memory" data-qme-panel="memory" hidden>
    <header><small>used by 48 of the 64 rounds</small><b>Keep a small table and correct it one token at a time</b></header>
    <p class="qme-intro">Here is the exact update from llama.cpp, shrunk from a 128 × 128 table to 2 × 2. <code>S</code> is the saved table. <code>k</code> chooses where to write, <code>v</code> is the desired value, and <code>q</code> chooses what to read.</p>
    <div class="qme-given">
      <span><small>old S</small><b>[[1, 0], [0, 1]]</b></span>
      <span><small>k</small><b>[1, 0]</b></span>
      <span><small>v</small><b>[2, 1]</b></span>
      <span><small>keep old</small><b>g = 0.5</b></span>
      <span><small>write strength</small><b>β = 1</b></span>
      <span><small>q</small><b>[0.5, 0.5]</b></span>
    </div>
    <ol class="qme-equations">
      <li><span>1</span><div><small>What would the old table return here?</small><code>old = Sᵀk = [1, 0]</code></div></li>
      <li><span>2</span><div><small>Find the missing information.</small><code>error = β(v − g × old) = [1.5, 1]</code></div></li>
      <li><span>3</span><div><small>Shrink old memory, then write the correction.</small><code>new S = gS + k × errorᵀ = [[2, 1], [0, 0.5]]</code></div></li>
      <li><span>4</span><div><small>Read from the new table.</small><code>answer = Sᵀq = [1, 0.75]</code></div></li>
    </ol>
    <p>Real Qwen runs this independently in 48 heads, each with a 128 × 128 table. Before the update it also mixes each input with the previous three positions. llama.cpp calls the fused CUDA operation <code>gated_delta_net</code>; “running memory” is the plainer description.</p>
  </section>

  <section class="qme-panel" id="qme-attention" role="tabpanel" aria-labelledby="qme-tab-attention" data-qme-panel="attention" hidden>
    <header><small>used by 16 of the 64 rounds</small><b>Score earlier positions, then take a weighted average</b></header>
    <p class="qme-intro">The current position makes a question vector <code>q = [1, 0]</code>. Each earlier position has a key and a value. The real vectors have 256 numbers; these have two.</p>
    <div class="qme-attention-table" role="table" aria-label="Worked attention calculation">
      <div class="head" role="row"><span>position</span><span>key</span><span>q · key ÷ √2</span><span>weight</span><span>value</span></div>
      <div role="row"><b>A</b><code>[1, 0]</code><code>0.71</code><b>46%</b><code>[2, 0]</code></div>
      <div role="row"><b>B</b><code>[0, 1]</code><code>0.00</code><b>22%</b><code>[0, 2]</code></div>
      <div role="row"><b>C</b><code>[0.5, 0.5]</code><code>0.35</code><b>32%</b><code>[1, 1]</code></div>
    </div>
    <div class="qme-attention-sum">
      <small>copy 46% of A, 22% of B and 32% of C</small>
      <code>0.46[2, 0] + 0.22[0, 2] + 0.32[1, 1]</code>
      <i>↓</i>
      <b>[1.23, 0.77]</b>
    </div>
    <p>The percentages come from <em>softmax</em>: exponentiate the three scores and divide by their sum. That only turns scores into positive weights adding to 100%. “Attention” is this lookup, not awareness.</p>
    <details>
      <summary>show the real sizes</summary>
      <p>Qwen makes {a.queryHeads} question heads and {a.kvHeads} shared key/value heads, each {a.headSize} numbers wide. Six question heads share each key/value head. It divides each dot product by √{a.headSize} = 16 before softmax.</p>
    </details>
  </section>

  <section class="qme-panel" id="qme-round" role="tabpanel" aria-labelledby="qme-tab-round" data-qme-panel="round" hidden>
    <header><small>what one of the 64 rounds does</small><b>Calculate a change, then add it to the same row</b></header>
    <div class="qme-round-flow">
      <span><small>start</small><b>x</b><em>{a.hiddenSize.toLocaleString()} numbers</em></span><i>→</i>
      <span><small>first change</small><b>remember <em>or</em> look back</b></span><i>→</i>
      <span class="add"><small>do not erase x</small><b>x + change</b></span><i>→</i>
      <span><small>second change</small><b>mix features</b></span><i>→</i>
      <span class="add"><small>again keep the old row</small><b>x + change</b></span>
    </div>
    <p>The additions are the important connection the box diagram hid. A round does not replace all {a.hiddenSize.toLocaleString()} numbers. It proposes a change and adds that change to what was already there.</p>
    <div class="qme-feature-math">
      <div><small>feature mixing for one number</small><code>SiLU(2) = 2 ÷ (1 + e<sup>−2</sup>) = 1.76</code></div>
      <i>×</i>
      <div><code>another learned result = −3</code></div>
      <i>＝</i>
      <div><b>−5.28</b></div>
    </div>
    <p>In Qwen, two matrix multiplications expand {a.hiddenSize.toLocaleString()} numbers to {a.intermediateSize.toLocaleString()}. SiLU bends one set of numbers smoothly, pairwise multiplication lets it gate the other set, and a third matrix multiplication returns to {a.hiddenSize.toLocaleString()} numbers.</p>
    <div class="qme-layer-map" aria-label="The 64 rounds in execution order">
      {data.layers.map((layer) => <span class={layer.kind}><small>{layer.index}</small>{layer.kind === 'attention' ? 'look' : 'keep'}</span>)}
    </div>
    <div class="qme-map-key"><span><i class="memory" />remember</span><span><i class="look" />look back</span><b>three remember + one look back · repeated 16 times</b></div>
  </section>

  <section class="qme-panel" id="qme-choose" role="tabpanel" aria-labelledby="qme-tab-choose" data-qme-panel="choose" hidden>
    <header><small>the actual first prediction</small><b>One final dot product for every possible next piece</b></header>
    <div class="qme-choice-example">
      <span><small>tiny final row</small><code>[2, −1]</code></span><i>·</i>
      <span><small>tiny “We” row</small><code>[3, 0.5]</code></span><i>＝</i>
      <b>2×3 − 1×0.5 = 5.5</b>
    </div>
    <p>Real Qwen compares its {a.hiddenSize.toLocaleString()} final numbers with {a.vocabSize.toLocaleString()} learned rows. That produces one raw score, called a <em>logit</em>, for every possible next piece.</p>
    <div class="qme-logits" aria-label="Ten largest raw scores captured before sampling">
      {data.topLogits.map((item) => (
        <div><span><small>{item.rank}</small><b>{item.piece}</b><code>ID {item.id}</code></span><i style={`width:${Math.max(2, item.logit / maxLogit * 100)}%`} /><em>{item.logit.toFixed(2)}</em></div>
      ))}
    </div>
    <p>These are the ten largest scores captured before sampling. The highest was <code>We</code>. Qwen appends the chosen ID to the prompt and performs the whole route again for the following piece.</p>
  </section>

  <section class="qme-panel" id="qme-cuda" role="tabpanel" aria-labelledby="qme-tab-cuda" data-qme-panel="cuda" hidden>
    <header><small>measured in the September 3 performance capture</small><b>Pick a row; see its arithmetic beside or below it</b></header>
    {profiledTurn ? (
      <>
        <p class="qme-intro">Nsight recorded {profiledTurn.kernelCount?.toLocaleString()} kernel launches in this {(profiledTurn.end - profiledTurn.start).toFixed(1)} second model turn. The bars add up CUDA kernel time, so overlapping GPU work can differ from wall time.</p>
        <div class="qme-cuda-browser">
          <div class="qme-kernel-list" aria-label="Profiled CUDA work">
            {kernelExplanations.map((item, index) => (
              <button type="button" data-kernel={item.group} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span><b>{item.label}</b><small>{item.kernel}</small></span>
                <i><em style={`width:${item.percent}%`} /></i>
                <strong>{item.percent.toFixed(1)}%</strong>
                <code>{item.milliseconds.toFixed(1)} ms</code>
              </button>
            ))}
          </div>
          <div class="qme-code-panes">
            {kernelExplanations.map((item, index) => (
              <div data-kernel-panel={item.group} hidden={index !== 0}>
                {'sourcePath' in item && item.sourcePath
                  ? <a href={`${llamaSourceBase}/${item.sourcePath}`}>{item.source}</a>
                  : <span>{item.source}</span>}
                <pre><code>{item.code}</code></pre>
                <p>{item.note}</p>
              </div>
            ))}
          </div>
        </div>
        <p>Not every operation has its own kernel. llama.cpp fuses some arithmetic together, while other steps require several launches. These groups come from kernel-name rules, not source-level GPU annotations.</p>
      </>
    ) : <p>No CUDA profile was supplied to this diagram.</p>}
  </section>

  <figcaption>
    The worked numbers are teaching examples; the operations are the ones executed by the captured llama.cpp graph. The token IDs, model sizes and final scores are from the rerun.
    {evidenceHref && <> <a href={evidenceHref}>Raw capture, source patch and commands.</a></>}
  </figcaption>
</figure>

