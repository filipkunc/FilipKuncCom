---
// A distributed trace rendered as a waterfall: one row per span, bar position
// = start offset, bar length = duration, color = which service the span
// belongs to. Click or focus a row to see the span's attributes: the model's
// thinking and decisions render as markdown, tool code and output as
// highlighted code blocks, the rest (gen_ai.* etc.) as a key/value grid.
// Panels are fully server-rendered; the click handler only swaps visibility.
// Data is a simplified Jaeger export from capture.py.
import { Code } from 'astro:components';
import { renderMd } from '../lib/md';

interface Span {
  id: string;
  parent: string | null;
  service: string;
  op: string;
  start_us: number;
  dur_us: number;
  tags: Record<string, unknown>;
}
interface Props {
  trace: { traceID: string; spans: Span[] };
  services?: string[]; // color order: first = c2 (blue), second = c1 (orange)
  // Optional capture.py metrics (epoch-second timestamps); when present, GPU
  // context strips render above the spans on the same time axis.
  metrics?: Record<string, [number, number][]>;
}
const { trace, services = ['agent', 'vllm'], metrics } = Astro.props;

// Depth-first order under parent links, keeping sibling start order.
const byParent = new Map<string | null, Span[]>();
for (const s of trace.spans) {
  const key = trace.spans.some((p) => p.id === s.parent) ? s.parent : null;
  (byParent.get(key) ?? byParent.set(key, []).get(key)!).push(s);
}
const rows: { span: Span; depth: number }[] = [];
function walk(parent: string | null, depth: number) {
  for (const s of byParent.get(parent) ?? []) {
    rows.push({ span: s, depth });
    walk(s.id, depth + 1);
  }
}
walk(null, 0);

const t0 = Math.min(...trace.spans.map((s) => s.start_us));
const total = Math.max(...trace.spans.map((s) => s.start_us + s.dur_us)) - t0;

// GPU context strips: metric points that fall inside the trace window,
// converted to trace time (µs from t0).
type Strip = { name: string; max: number; unit: string; pts: [number, number][] };
const strips: Strip[] = [];
if (metrics) {
  const inWindow = (key: string) =>
    (metrics[key] ?? [])
      .map(([ts, v]) => [ts * 1e6 - t0, v] as [number, number])
      .filter(([t]) => t >= -0.5e6 && t <= total + 0.5e6)
      .map(([t, v]) => [Math.max(0, Math.min(total, t)), v] as [number, number]);
  const gpu = inWindow('nvml_gpu_utilization_percent');
  const pw = inWindow('nvml_power_watts');
  const mem = inWindow('nvml_memory_used_bytes').map(([t, v]) => [t, v / 2 ** 30] as [number, number]);
  const memTotal = (metrics['nvml_memory_total_bytes'] ?? [])[0]?.[1];
  if (gpu.length > 1) strips.push({ name: 'GPU busy', max: 100, unit: '%', pts: gpu });
  if (mem.length > 1 && memTotal) strips.push({ name: 'GPU memory', max: Math.round(memTotal / 2 ** 30), unit: 'GiB', pts: mem });
  if (pw.length > 1) strips.push({ name: 'GPU power', max: Math.ceil(Math.max(...pw.map(([, v]) => v)) / 50) * 50, unit: 'W', pts: pw });
}

// Geometry. Left column for names, right side for time. Strips sit between
// the tick labels and the span rows.
const W = 680, NAME_W = 170, ROW_H = 26, PAD = 8;
const STRIP_H = 34, STRIP_GAP = 10;
const TOP = 26 + strips.length * (STRIP_H + STRIP_GAP);
const plotW = W - NAME_W - PAD;
const H = TOP + rows.length * ROW_H + 6;
const stripY = (i: number) => 22 + i * (STRIP_H + STRIP_GAP);
const stripPoly = (s: Strip) =>
  s.pts.map(([t, v]) => `${(NAME_W + (t / total) * plotW).toFixed(1)},${(STRIP_H - (v / s.max) * STRIP_H).toFixed(1)}`).join(' ');
const x = (us: number) => NAME_W + (us / total) * plotW;
const fmt = (us: number) => (us >= 1e6 ? `${(us / 1e6).toFixed(2)}s` : `${Math.round(us / 1e3)}ms`);
const tickStep = total > 8e6 ? 2e6 : 1e6;
const ticks = Array.from({ length: Math.floor(total / tickStep) + 1 }, (_, i) => i * tickStep);
const cls = (s: Span) => (services.indexOf(s.service) === 1 ? 'c1' : 'c2');

// Bars shorter than this get their duration label outside, to the right.
const labelInside = (s: Span) => (s.dur_us / total) * plotW > 56;

// Split each span's attributes into rich sections and leftover key/values.
// vLLM's llm_request spans get their gen_ai.latency.* split lifted into a
// phase breakdown instead of a raw key dump.
const fmtS = (s: number) => (s >= 1 ? `${s.toFixed(2)}s` : `${Math.round(s * 1000)}ms`);
const detail = await Promise.all(rows.map(async ({ span }) => {
  const t = { ...span.tags } as Record<string, any>;
  delete t['span.kind'];
  const take = (k: string) => { const v = t[k]; delete t[k]; return v; };
  // Mean of each GPU strip inside this span's window, for the panel readout.
  const s0 = span.start_us - t0, s1 = s0 + span.dur_us;
  const gpuStats = strips
    .map((st) => {
      const inSpan = st.pts.filter(([pt]) => pt >= s0 && pt <= s1).map(([, v]) => v);
      if (!inSpan.length) {
        const nearest = st.pts.reduce((a, b) => (Math.abs(b[0] - s0) < Math.abs(a[0] - s0) ? b : a));
        inSpan.push(nearest[1]);
      }
      const mean = inSpan.reduce((a, b) => a + b, 0) / inSpan.length;
      return `${st.name.replace('GPU ', '')} ${st.unit === 'GiB' ? mean.toFixed(1) : Math.round(mean)}${st.unit}`;
    })
    .join(' · ');
  let phases = null;
  if (t['gen_ai.latency.time_in_model_decode'] !== undefined) {
    const num = (k: string) => Number(take(k) ?? 0);
    const queue = num('gen_ai.latency.time_in_queue');
    const prefill = num('gen_ai.latency.time_in_model_prefill');
    const decode = num('gen_ai.latency.time_in_model_decode');
    num('gen_ai.latency.time_in_model_inference'); // ≈ prefill + decode, drop
    const e2e = num('gen_ai.latency.e2e');
    const ttft = num('gen_ai.latency.time_to_first_token');
    const tokIn = num('gen_ai.usage.prompt_tokens');
    const tokOut = num('gen_ai.usage.completion_tokens');
    phases = {
      queue, prefill, decode, e2e, ttft, tokIn, tokOut,
      stats: `${tokIn} tok in → ${tokOut} tok out · TTFT ${fmtS(ttft)} · decode ${Math.round(tokOut / Math.max(decode, 1e-9))} tok/s`,
      segs: [
        { name: 'queue', cls: 'ph-queue', sec: queue },
        { name: 'prefill', cls: 'ph-prefill', sec: prefill },
        { name: 'decode', cls: 'ph-decode', sec: decode },
      ].map((seg) => ({ ...seg, pct: (seg.sec / e2e) * 100, label: `${seg.name} ${fmtS(seg.sec)}` })),
    };
  }
  const thinking = take('thinking');
  const answer = take('answer');
  return {
    id: span.id,
    cls: cls(span),
    gpuStats,
    title: `${span.service} · ${span.op} — ${fmt(span.dur_us)}`,
    thinkingHtml: thinking ? await renderMd(thinking) : '',
    decision: take('decision'),
    code: take('tool_call.code') ?? take('code'),
    stdout: take('stdout'),
    answerHtml: answer ? await renderMd(answer) : '',
    phases,
    rest: Object.entries(t) as [string, any][],
  };
}));
const hasPhases = detail.some((d) => d.phases);
---

<figure class="diagram trace-waterfall">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
    aria-label={`Trace waterfall with ${rows.length} spans over ${fmt(total)}. Model calls dominate the timeline; the tool executions between them are fractions of a second.`}>
    {ticks.map((t) => (
      <>
        <line class="tw-grid" x1={x(t)} y1={18} x2={x(t)} y2={H - 6} />
        <text class="tw-tick" x={x(t) + 3} y={12}>{t / 1e6}s</text>
      </>
    ))}
    {strips.map((s, i) => (
      <g transform={`translate(0 ${stripY(i)})`}>
        <text class="tw-strip-name" x={NAME_W - 8} y={STRIP_H / 2 + 3} text-anchor="end">{s.name}</text>
        <text class="tw-strip-lim" x={NAME_W - 8} y="7" text-anchor="end">{s.max}{s.unit}</text>
        <text class="tw-strip-lim" x={NAME_W - 8} y={STRIP_H + 1} text-anchor="end">0</text>
        <line class="tw-strip-base" x1={NAME_W} y1={STRIP_H} x2={W - PAD} y2={STRIP_H} />
        <polyline class="tw-strip-line" points={stripPoly(s)} />
      </g>
    ))}
    <rect class="tw-select-band" x="0" y="18" width="0" height={H - 24} rx="3" />
    {rows.map(({ span, depth }, i) => {
      const y = TOP + i * ROW_H;
      const bx = x(span.start_us - t0);
      const bw = Math.max(3, (span.dur_us / total) * plotW);
      const ph = detail[i].phases;
      const prefillW = ph ? (ph.prefill * 1e6 / total) * plotW : 0;
      return (
        <g class="tw-row" data-span={span.id} data-bx={bx.toFixed(1)} data-bw={bw.toFixed(1)} tabindex="0" role="button"
          aria-label={`${span.service} ${span.op}, ${fmt(span.dur_us)}. Shows attributes.`}>
          <rect class="tw-hit" x="0" y={y} width={W} height={ROW_H} rx="4" />
          <text class="tw-name" x={6 + depth * 14} y={y + ROW_H / 2 + 4}>{span.op}</text>
          <rect class={`tw-bar ${cls(span)}`} x={bx} y={y + (ROW_H - 12) / 2} width={bw} height="12" rx="3" />
          {ph && prefillW > 1 && (
            <rect class="tw-bar-prefill" x={bx} y={y + (ROW_H - 12) / 2} width={prefillW} height="12" rx="3" />
          )}
          <text
            class={`tw-dur ${labelInside(span) ? 'inside' : ''}`}
            x={labelInside(span) ? bx + bw - 5 : Math.min(bx + bw + 5, W - 40)}
            y={y + ROW_H / 2 + 4}
            text-anchor={labelInside(span) ? 'end' : 'start'}
          >{fmt(span.dur_us)}</text>
        </g>
      );
    })}
  </svg>
  <div class="tw-legend">
    {services.map((s, i) => (
      <span class="tw-key"><span class={`tw-swatch ${i === 1 ? 'c1' : 'c2'}`} /> {s}</span>
    ))}
    {hasPhases && <span class="tw-key"><span class="tw-swatch swatch-prefill" /> prefill part</span>}
    <span class="tw-hint">click a span for its attributes</span>
  </div>
  <div class="tw-panels">
    {detail.map((d) => (
      <div class="tw-panel" data-panel={d.id} hidden>
        <div class={`tw-panel-title ${d.cls}`}>{d.title}</div>
        {d.gpuStats && <p class="tw-stats tw-gpustats"><span class="tw-sec-label">gpu during span</span> {d.gpuStats}</p>}
        {d.phases && (
          <>
            <p class="tw-stats">{d.phases.stats}</p>
            <div class="tw-phasebar" role="img" aria-label={d.phases.segs.map((s) => s.label).join(', ')}>
              {d.phases.segs.map((s) => s.pct > 0.2 && <span class={s.cls} style={`width:${s.pct}%`} />)}
            </div>
            <div class="tw-phasekeys">
              {d.phases.segs.map((s) => (
                <span class="tw-key"><span class={`tw-swatch ${s.cls}`} /> {s.label}</span>
              ))}
            </div>
          </>
        )}
        {d.decision && <p class="tw-sec"><span class="tw-sec-label">decision</span> {d.decision}</p>}
        {d.thinkingHtml && (
          <>
            <div class="tw-sec-label">thinking</div>
            <div class="tw-md" set:html={d.thinkingHtml} />
          </>
        )}
        {d.code && (
          <>
            <div class="tw-sec-label">python</div>
            <Code code={d.code} lang="python" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
          </>
        )}
        {d.stdout && (
          <>
            <div class="tw-sec-label">stdout</div>
            <Code code={d.stdout} lang="text" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="dark" />
          </>
        )}
        {d.answerHtml && (
          <>
            <div class="tw-sec-label">answer</div>
            <div class="tw-md" set:html={d.answerHtml} />
          </>
        )}
        {d.rest.length > 0 && (
          <dl class="tw-kv">
            {d.rest.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{typeof v === 'number' && !Number.isInteger(v) ? (v as number).toFixed(4) : String(v)}</dd>
              </>
            ))}
          </dl>
        )}
      </div>
    ))}
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  figure.trace-waterfall { --ch1: #f05a1e; --ch2: #3f8edd; }
  :global(:root[data-theme='light']) figure.trace-waterfall { --ch1: #c34a16; --ch2: #1f6fc4; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) figure.trace-waterfall { --ch1: #c34a16; --ch2: #1f6fc4; }
  }
  figure.trace-waterfall svg { user-select: none; -webkit-user-select: none; }
  .tw-grid { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 2 5; }
  .tw-strip-name { fill: var(--fg); font: 600 11px ui-sans-serif, system-ui, sans-serif; }
  .tw-strip-lim { fill: var(--muted); font: 9px ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .tw-strip-base { stroke: var(--rule); stroke-width: 1; }
  .tw-strip-line { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-linejoin: round; }
  .tw-tick { fill: var(--muted); font: 10px ui-sans-serif, system-ui, sans-serif; }
  .tw-row { cursor: pointer; outline: none; }
  .tw-hit { fill: transparent; }
  .tw-row:hover .tw-hit, .tw-row:focus-visible .tw-hit { fill: color-mix(in srgb, var(--fg) 7%, transparent); }
  .tw-row.selected .tw-hit { fill: color-mix(in srgb, var(--accent) 12%, transparent); }
  .tw-name { fill: var(--fg); font: 11px ui-monospace, monospace; }
  .tw-bar.c1 { fill: var(--ch1); }
  .tw-bar.c2 { fill: var(--ch2); }
  .tw-bar-prefill { fill: var(--bg); opacity: 0.45; }
  .tw-select-band { fill: color-mix(in srgb, var(--accent) 9%, transparent); display: none; }
  figure.trace-waterfall.has-selection .tw-select-band { display: block; }
  .tw-dur { fill: var(--muted); font: 10px ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .tw-dur.inside { fill: color-mix(in srgb, #fff 92%, transparent); }
  .tw-legend {
    display: flex; gap: 1rem; justify-content: center; align-items: center;
    font-size: 0.78rem; color: var(--muted); margin-top: 0.25rem; flex-wrap: wrap;
  }
  .tw-swatch { display: inline-block; width: 12px; height: 6px; border-radius: 3px; vertical-align: middle; }
  .tw-swatch.c1 { background: var(--ch1); }
  .tw-swatch.c2 { background: var(--ch2); }
  .tw-panel {
    margin: 0.6rem 0 0; text-align: left; color: var(--fg);
    border: 1px solid var(--rule); border-radius: 8px; padding: 0.7rem 0.9rem;
    font-size: 0.82rem;
  }
  .tw-panel[hidden] { display: none; }
  /* Title hue follows the service, same mapping as the bars, but on the
     theme's text-safe tokens (small text needs more contrast than marks). */
  .tw-panel-title { font: 600 0.8rem ui-monospace, monospace; margin-bottom: 0.4rem; }
  .tw-panel-title.c1 { color: var(--accent); }
  .tw-panel-title.c2 { color: var(--link); }
  .tw-stats { margin: 0.2rem 0 0.5rem; font: 0.78rem ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  .tw-phasebar {
    display: flex; height: 10px; border-radius: 5px; overflow: hidden;
    background: color-mix(in srgb, var(--rule) 55%, transparent);
  }
  .tw-phasebar .ph-queue { background: var(--muted); }
  .tw-phasebar .ph-prefill { background: color-mix(in srgb, var(--ch1) 45%, var(--bg)); }
  .tw-phasebar .ph-decode { background: var(--ch1); }
  .tw-phasekeys { display: flex; gap: 1rem; flex-wrap: wrap; margin: 0.3rem 0 0.2rem; font-size: 0.72rem; color: var(--muted); }
  .tw-phasekeys .tw-swatch.ph-queue { background: var(--muted); }
  .tw-phasekeys .tw-swatch.ph-prefill { background: color-mix(in srgb, var(--ch1) 45%, var(--bg)); }
  .tw-phasekeys .tw-swatch.ph-decode { background: var(--ch1); }
  .swatch-prefill { background: color-mix(in srgb, var(--ch1) 45%, var(--bg)); }
  .tw-sec { margin: 0.3rem 0; }
  .tw-sec-label {
    display: inline-block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); margin: 0.5rem 0 0.15rem;
  }
  .tw-md :global(p) { margin: 0.3rem 0; }
  .tw-md :global(code) { font-size: 0.9em; }
  .tw-panel :global(pre) { margin: 0.2rem 0; padding: 0.6rem 0.8rem; border-radius: 6px; font-size: 0.78rem; overflow-x: auto; }
  .tw-kv {
    margin: 0.5rem 0 0; display: grid; grid-template-columns: max-content 1fr;
    column-gap: 1rem; row-gap: 0.15rem; font: 0.75rem ui-monospace, monospace;
  }
  .tw-kv dt { color: var(--muted); margin: 0; }
  .tw-kv dd { margin: 0; overflow-wrap: anywhere; }
</style>

<script>
  function setup(fig: HTMLElement) {
    const rows = [...fig.querySelectorAll<SVGGElement>('.tw-row')];
    const panels = [...fig.querySelectorAll<HTMLElement>('.tw-panel')];
    const band = fig.querySelector<SVGRectElement>('.tw-select-band')!;

    function select(id: string) {
      for (const r of rows) r.classList.toggle('selected', r.dataset.span === id);
      for (const p of panels) p.hidden = p.dataset.panel !== id;
      const row = rows.find((r) => r.dataset.span === id)!;
      band.setAttribute('x', row.dataset.bx!);
      band.setAttribute('width', row.dataset.bw!);
      fig.classList.add('has-selection');
    }

    for (const r of rows) {
      r.addEventListener('click', () => select(r.dataset.span!));
      r.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); select(r.dataset.span!); }
      });
    }
  }
  document.querySelectorAll<HTMLElement>('figure.trace-waterfall').forEach(setup);
</script>
