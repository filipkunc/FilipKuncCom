---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts, PAGE_SIZE, pageUrl } from '../lib/posts';

const allPosts = await getSortedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
// Home shows the newest page, so send "view more" straight to page 2 — readers
// skip re-scanning the posts they just saw here.
const hasMore = allPosts.length > posts.length;
---

<Layout title="filipkunc.com" description="Notes, projects, and experiments by Filip Kunc.">
  <h1>Recent posts</h1>
  <PostList posts={posts} />
  {hasMore && (
    <p class="more-link"><a href={pageUrl(2)}>Older posts →</a></p>
  )}

  <h2>Projects</h2>
  <ul>
    <li><a href="/meshmaker">MeshMaker</a> — WebGL2 + WASM port of a 3D mesh editor for macOS | Windows | Linux.</li>
    <li><a href="/space-warrior">Space Warrior</a> — Platformer in DirectX and C++ ported to web (2002-2003).</li>
    <li><a href="/gentis">Gentis</a> — OpenGL 3D third-person shooter (2004-2005).</li>
  </ul>
</Layout>
