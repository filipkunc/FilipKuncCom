/public/og/
/public/og-default.png
.astro/
.cache/
npm-debug.log*
.env
.env.local
*.local
.DS_Store
__pycache__/
*.pyc
.venv/
ansible/inventory.yml
ansible/.vault_pass

# Playwright
test-results/
playwright-report/
.playwright/

# Benchmark build artifacts (sources + results JSON are committed)
.tools/
bench/normals/mesh.bin
bench/normals/run-cuda
bench/normals/run-opencl
bench/normals/run-slang-host
bench/normals/run-slang.ptx

# Bazel convenience symlinks for the tcmalloc bench
bench/tcmalloc/bazel-*

# hb-editor: full fonts are fetched by build-wasm.sh; the wasm and the web
# font subsets ARE committed so the container build (git archive of the
# committed tree) is self-contained, same as the MeshMaker wasm in public/.
scripts/hb-editor/fonts/*.ttf
!scripts/hb-editor/fonts/*-subset.ttf
!scripts/hb-editor/dist/
!scripts/hb-editor/dist/hb-gpu.mjs
!scripts/hb-editor/dist/hb-gpu.wasm

# flowfield: cargo build dir is local-only; the wasm artifact IS committed
# (same rationale as hb-gpu.wasm above)
scripts/flowfield/target/
!scripts/flowfield/dist/
!scripts/flowfield/dist/flowfield.wasm

# ast-explorer: the oxc transform crate lives here; its cargo target/ is
# local-only and dist/oxc_wasm_web.wasm (built by build-oxc-wasm.sh) IS committed,
# same rationale as hb-gpu.wasm and flowfield.wasm above.
scripts/ast-explorer/target/
!scripts/ast-explorer/dist/
!scripts/ast-explorer/dist/oxc_wasm_web.wasm


# collab-board: the axum server (WebSocket + data-star SSE) for the shared-board
# post is a standalone binary; target/ is the local cargo build dir. The
# ws.html/sse.html clients and src/ are excerpted by the post, so they ARE
# committed. (Cargo.lock committed: application, not a library.)
scripts/collab-board/target/

# Post research dossiers: working notes, never shipped
research/

# Parked tokio-websocket-shooter branch: local cargo build dir of its checkout
scripts/websocket-shooter/target/
